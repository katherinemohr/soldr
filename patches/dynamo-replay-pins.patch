+/// Workers that KV Router placement must use, keyed by trace request ID, read from the JSON file named by
+/// `DYN_REPLAY_PINS`: `{"aggregated": {id: worker}, "prefill": {...}, "decode": {...}}`. Only agentic traces
+/// carry request IDs. Requests without a pin are routed as usual.
+#[derive(Default, serde::Deserialize)]
+#[serde(default, deny_unknown_fields)]
+struct ReplayPins {
+    aggregated: HashMap<String, WorkerId>,
+    prefill: HashMap<String, WorkerId>,
+    decode: HashMap<String, WorkerId>,
+}
+
+fn replay_pins() -> Result<ReplayPins> {
+    let Ok(path) = std::env::var("DYN_REPLAY_PINS") else {
+        return Ok(ReplayPins::default());
+    };
+    let file = std::fs::File::open(&path).with_context(|| format!("opening DYN_REPLAY_PINS {path}"))?;
+    serde_json::from_reader(std::io::BufReader::new(file))
+        .with_context(|| format!("parsing DYN_REPLAY_PINS {path}"))
+}
